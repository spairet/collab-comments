{
  "name": "comment-tracker",
  "displayName": "Comment Tracker",
  "description": "Track comments with author and timestamp for QMD and other files",
  "version": "0.0.2",
  "publisher": "MichaelLydeamore",
  "repository": {
    "type": "git",
    "url": "https://github.com/MikeLydeamore/collab-comments"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Comment Tracker",
      "properties": {
        "commentTracker.defaultAuthor": {
          "type": "string",
          "default": "",
          "description": "Your default name for comments. If empty, will prompt each time or use system username."
        }
      }
    },
    "commands": [
      {
        "command": "comment-tracker.addComment",
        "title": "Comment Tracker: Add Comment"
      },
      {
        "command": "comment-tracker.viewComments",
        "title": "Comment Tracker: View Comments in Current File"
      },
      {
        "command": "comment-tracker.deleteComment",
        "title": "Comment Tracker: Delete Comment"
      },
      {
        "command": "comment-tracker.deleteCommentThread",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "comment-tracker.resolveCommentThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "comment-tracker.unresolveCommentThread",
        "title": "Unresolve",
        "icon": "$(close)"
      },
      {
        "command": "comment-tracker.mergeTrackedChanges",
        "title": "Merge Tracked Changes",
        "icon": "$(git-merge)"
      },
      {
        "command": "comment-tracker.replyNote",
        "title": "Reply"
      },
      {
        "command": "comment-tracker.deleteReply",
        "title": "Delete Reply",
        "icon": "$(trash)"
      },
      {
        "command": "comment-tracker.exportToMarkdown",
        "title": "Comment Tracker: Export Comments to Markdown"
      },
      {
        "command": "comment-tracker.deleteAllComments",
        "title": "Comment Tracker: Delete All Comments"
      },
      {
        "command": "comment-tracker.openReviewPanel",
        "title": "Comment Tracker: Open Review Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "comment-tracker.showResolvedComments",
        "title": "Show Resolved Comments",
        "icon": "$(eye)"
      },
      {
        "command": "comment-tracker.hideResolvedComments",
        "title": "Hide Resolved Comments",
        "icon": "$(eye-closed)"
      },
      {
        "command": "comment-tracker.resolveTreeComment",
        "title": "Resolve Comment",
        "icon": "$(check)"
      },
      {
        "command": "comment-tracker.unresolveTreeComment",
        "title": "Unresolve Comment",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "comment-tracker.addComment",
          "group": "navigation"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "comment-tracker.resolveCommentThread",
          "group": "inline@1",
          "when": "commentController == comment-tracker && (commentThread == commentTrackerThreadOpen || commentThread == commentTrackerThreadOpenCanMerge)"
        },
        {
          "command": "comment-tracker.unresolveCommentThread",
          "group": "inline@1",
          "when": "commentController == comment-tracker && (commentThread == commentTrackerThreadResolved || commentThread == commentTrackerThreadResolvedCanMerge)"
        },
        {
          "command": "comment-tracker.mergeTrackedChanges",
          "group": "inline@2",
          "when": "commentController == comment-tracker && (commentThread == commentTrackerThreadOpenCanMerge || commentThread == commentTrackerThreadResolvedCanMerge)"
        },
        {
          "command": "comment-tracker.deleteCommentThread",
          "group": "inline@3",
          "when": "commentController == comment-tracker && (commentThread == commentTrackerThreadOpen || commentThread == commentTrackerThreadOpenCanMerge || commentThread == commentTrackerThreadResolved || commentThread == commentTrackerThreadResolvedCanMerge)"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "comment-tracker.replyNote",
          "group": "inline@1",
          "when": "commentController == comment-tracker"
        }
      ],
      "view/title": [
        {
          "command": "comment-tracker.openReviewPanel",
          "group": "navigation@1",
          "when": "view == commentTrackerView"
        },
        {
          "command": "comment-tracker.showResolvedComments",
          "group": "navigation@2",
          "when": "view == commentTrackerView && !commentTracker.showResolvedComments"
        },
        {
          "command": "comment-tracker.hideResolvedComments",
          "group": "navigation@2",
          "when": "view == commentTrackerView && commentTracker.showResolvedComments"
        }
      ],
      "view/item/context": [
        {
          "command": "comment-tracker.resolveTreeComment",
          "group": "navigation@1",
          "when": "view == commentTrackerView && viewItem == commentTrackerOpenComment"
        },
        {
          "command": "comment-tracker.unresolveTreeComment",
          "group": "navigation@1",
          "when": "view == commentTrackerView && viewItem == commentTrackerResolvedComment"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "comment-tracker-container",
          "title": "Comment Tracker",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "comment-tracker-container": [
        {
          "id": "commentTrackerView",
          "name": "Review Comments"
        }
      ]
    },
    "keybindings": []
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node ./esbuild.js",
    "watch": "node ./esbuild.js --watch",
    "package": "node ./esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run compile-tests && node --test out/anchors.test.js out/repository.test.js",
    "test:extension": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "esbuild": "^0.19.10",
    "typescript": "^5.3.3",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8"
  },
  "publisher": "MichaelLydeamore"
}
